{
  "version": 3,
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "environment": { "VSLANG": "1033" },
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/web-${presetName}",
      "installDir": "${sourceDir}/pack/app",
      "architecture": { "value": "x64", "strategy": "external" },
      "cacheVariables": { "CMAKE_CXX_COMPILER": "cl.exe" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "x64-debug",
      "displayName": "HTML 界面 · 调试",
      "inherits": "windows-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "BUILD_TESTING": "ON" }
    },
    {
      "name": "x64-release",
      "displayName": "HTML 界面 · 发布",
      "inherits": "windows-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "BUILD_TESTING": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "x64-debug", "configurePreset": "x64-debug" },
    { "name": "x64-release", "configurePreset": "x64-release" }
  ],
  "testPresets": [
    { "name": "x64-debug", "configurePreset": "x64-debug", "output": { "outputOnFailure": true } },
    { "name": "x64-release", "configurePreset": "x64-release", "output": { "outputOnFailure": true } }
  ]
}
