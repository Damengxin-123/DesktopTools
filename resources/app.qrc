<RCC>
  <qresource prefix="/web">
    <file alias="index.html">../web/index.html</file>
    <file alias="styles.css">../web/styles.css</file>
    <file alias="bridge.js">../web/bridge.js</file>
    <file alias="downloads.js">../web/downloads.js</file>
    <file alias="clipboard.js">../web/clipboard.js</file>
    <file alias="emoji.js">../web/emoji.js</file>
    <file alias="wallpaper.html">../web/wallpaper.html</file>
    <file alias="wallpaper.js">../web/wallpaper.js</file>
    <file alias="wallpaper-layout.js">../web/wallpaper-layout.js</file>
    <file alias="app.js">../web/app.js</file>
  </qresource>
  <qresource prefix="/images">
    <file alias="app_icon.ico">images/app_icon.ico</file>
    <file alias="app_icon.png">images/app_icon.png</file>
    <file alias="github-avatar.jpg">images/github-avatar.jpg</file>
  </qresource>
</RCC>
